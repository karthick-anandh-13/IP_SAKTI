# --- Vector DB ---
QDRANT_MODE=local            # "local" (on-disk, no server) or "server" (remote Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./qdrant_storage
QDRANT_COLLECTION=ip_sakti_kb

# --- Embeddings ---
# Multilingual model: covers Hindi, Tamil, Sanskrit (IAST/Devanagari), English, etc.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIM=768

# --- LLM (answer synthesis) ---
# Set to "anthropic" to use Claude for synthesis, or "template" for a
# no-API-key extractive fallback (useful for offline demos / grading).
LLM_PROVIDER=template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Retrieval ---
TOP_K=5
SCORE_THRESHOLD=0.30

# --- Multilingual I/O ---
# Bhashini API would be wired in here in production for ASR/translation.
BHASHINI_API_KEY=
BHASHINI_ENDPOINT=
DEFAULT_RESPONSE_LANGUAGE=auto   # "auto" = respond in the query's language
